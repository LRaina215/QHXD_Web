RK_BACKEND_BASE_URL=http://100.113.173.115:8000
PUBLIC_API_TOKEN=change-me
MEDIA_PUBLISH_USER=robot-publisher
MEDIA_PUBLISH_PASSWORD=replace-with-a-separate-publish-secret
