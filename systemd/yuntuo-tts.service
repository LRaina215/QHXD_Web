[Unit]
Description=YunTuo on-board TTS (sherpa-onnx, POST 127.0.0.1:8081/tts)
Before=qhxd-backend.service

[Service]
Type=simple
User=robomaster
Group=robomaster
WorkingDirectory=/home/robomaster/QHXD
ExecStart=/home/robomaster/QHXD/scripts/run_yuntuo_tts.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGINT
SyslogIdentifier=yuntuo-tts

[Install]
WantedBy=multi-user.target
