# DeepSeek V4 API configuration
LLM_BACKEND=deepseek
LLM_ENABLE=false
DEEPSEEK_ENABLE=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=5
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.1

# LLM safety
LLM_CONFIDENCE_THRESHOLD=0.75
LLM_REQUIRE_CONFIRM_FOR_MOTION=true
LLM_FALLBACK_TO_RULE=true
LLM_DEBUG_RAW=false
VOICE_PENDING_TTL_SECONDS=30

# Dashboard latest-frame image refresh interval. 1000 means the frontend requests /api/perception/latest_frame once per second.
VITE_LATEST_FRAME_INTERVAL_MS=2000
VITE_USE_MJPEG_STREAM=true
PERCEPTION_MJPEG_INTERVAL_MS=200
VITE_DETECTION_EVENT_HOLD_MS=15000
VITE_DETECTION_EVENT_MAX_ITEMS=12

# Phase 9B TTS (Text-to-Speech)
# mock: placeholder, does not call any external API
# online: calls TTS_ONLINE_API_URL to generate real audio
# local: same as online, kept for future offline TTS model
TTS_BACKEND=mock

# Online TTS provider (MiMO / other compatible API)
# Fill in your API endpoint, key, model and voice.
TTS_ONLINE_API_URL=
TTS_ONLINE_API_KEY=
TTS_ONLINE_MODEL=
TTS_ONLINE_VOICE=zh-CN-XiaoxiaoNeural
TTS_API_TIMEOUT=15
# TTS_AUDIO_DIR defaults to backend/data/tts/ if not set
# TTS_AUDIO_FORMAT: wav or mp3
TTS_AUDIO_FORMAT=wav
# TTS_MAX_AUDIO_FILES: keep at most this many audio files on disk
TTS_MAX_AUDIO_FILES=20

# RK3588 local speaker playback (optional)
# Set TTS_AUTO_PLAY_LOCAL=true to play TTS audio through the board speaker
TTS_AUTO_PLAY_LOCAL=false
TTS_PLAYER_CMD=aplay -D plughw:2,0
WEATHER_LOCATION=海南海口
WEATHER_TEMPERATURE_C=28.6
WEATHER_HUMIDITY_PERCENT=82
WEATHER_TEXT=多云
WEATHER_WIND=东南风
