# DeepSeek V4 API configuration
LLM_BACKEND=deepseek
LLM_ENABLE=false
DEEPSEEK_ENABLE=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DISPLAY_MODEL="DeepSeek V4 Flash"
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.1

# LLM safety
LLM_CONFIDENCE_THRESHOLD=0.75
LLM_REQUIRE_CONFIRM_FOR_MOTION=true
LLM_FALLBACK_TO_RULE=true
LLM_DEBUG_RAW=false
VOICE_PENDING_TTL_SECONDS=30

# Phase 10 F1 Nav2 mission executor (loopback only)
NAV_MISSION_EXECUTOR_BASE_URL=http://127.0.0.1:9101
NAV_MISSION_EXECUTOR_PATH=/api/internal/mission
NAV_MISSION_EXECUTOR_PORT=9101
NAV_MISSION_EXECUTOR_TIMEOUT_SECONDS=4
NAV_MISSION_MAX_NAV_AGE_SECONDS=3
NAV_MISSION_PREFLIGHT_ENABLED=true
NAV_MISSION_FRAME_ID=map
NAV_MISSION_BACKEND_UPDATE_URL=http://127.0.0.1:8000/api/internal/mission/update
WAYPOINTS_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/waypoints.json
PATROL_ROUTES_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/patrol_routes.json
MISSION_EVENT_TTS_ENABLED=true

# Navigation autostart and fixed startup pose. The pose must match the robot's
# physical parking position on sentinel_map.
QHXD_BOOT_START_NAV_FRONTEND=true
QHXD_BOOT_NAV_MODE=bringup
QHXD_BOOT_START_NAV_WEB_BRIDGE=true
QHXD_NAV_BOOT_MIN_UPTIME_SECONDS=90
QHXD_NAV_WEB_BRIDGE_MAP_WATCHDOG=true
QHXD_NAV_WEB_BRIDGE_MAP_WAIT_SECONDS=600
QHXD_NAV_INITIAL_POSE_ENABLED=true
QHXD_NAV_INITIAL_POSE_X=-1.05
QHXD_NAV_INITIAL_POSE_Y=4.54
QHXD_NAV_INITIAL_POSE_YAW=0.0
QHXD_NAV_INITIAL_POSE_WAIT_SECONDS=600

# FunASR and RK3588 ALSA capture
ASR_BACKEND=funasr
FUNASR_MODEL_PATH=/home/robomaster/.cache/modelscope/hub/models/iic/SenseVoiceSmall
FUNASR_VAD_MODEL_PATH=/home/robomaster/.cache/modelscope/hub/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_DEVICE=cpu
FUNASR_LANGUAGE=zh
FUNASR_USE_ITN=true
FUNASR_DISABLE_UPDATE=true
AUDIO_DEVICE=plughw:CARD=Device,DEV=0
AUDIO_RECORD_SECONDS=3
AUDIO_CHANNELS=1
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=S16_LE

# ROS 2 IMU -> backend bridge. Use python for an immediate runtime rollback.
ROS2_IMU_BRIDGE_IMPL=cpp
ROS2_IMU_TOPIC=/serial/imu_backend
ROS2_IMU_BRIDGE_RATE_HZ=20
ROS2_IMU_HEARTBEAT_FILE=/home/robomaster/QHXD/.runtime/ros2_imu_bridge.heartbeat
CBOARD_HEARTBEAT_MAX_AGE_SECONDS=3

# Dashboard latest-frame image refresh interval
VITE_LATEST_FRAME_INTERVAL_MS=2000
VITE_USE_MJPEG_STREAM=true
PERCEPTION_MJPEG_INTERVAL_MS=200
VITE_DETECTION_EVENT_HOLD_MS=15000
VITE_DETECTION_EVENT_MAX_ITEMS=12

# Independent H.264 video path (Hik MVS -> RK MPP -> cloud MediaMTX)
QHXD_VIDEO_STREAM_ENABLED=false
# Keep publisher credentials in the real .env only. RTMP credentials use query parameters.
QHXD_VIDEO_STREAM_URL='rtmp://100.118.160.119:1935/robot/front?user=robot-publisher&pass=replace-me'

# Phase 9B TTS (Text-to-Speech) - MiMO V2.5
# mock: placeholder, does not call any external API
# online: calls MiMO TTS API (mimo-v2.5-tts) to generate real audio
TTS_BACKEND=mock

# MiMO TTS API configuration
# Get your API key from https://api.xiaomimimo.com
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
# Built-in voices: 冰糖, 茉莉, 苏打, 白桦 (Chinese); Mia, Chloe, Milo, Dean (English)
MIMO_TTS_VOICE=茉莉
MIMO_TTS_FORMAT=wav
TTS_API_TIMEOUT=15
# TTS_AUDIO_DIR defaults to backend/data/tts/ if not set
TTS_MAX_AUDIO_FILES=20

# RK3588 local speaker playback (optional)
# Set TTS_AUTO_PLAY_LOCAL=true to play TTS audio through the board speaker
TTS_AUTO_PLAY_LOCAL=false
TTS_PLAYER_CMD="aplay -D plughw:2,0"

# Smart assistant real-time weather (Open-Meteo, no API key required)
WEATHER_LOCATION=海南海口
WEATHER_LATITUDE=20.0440
WEATHER_LONGITUDE=110.1999
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_TIMEOUT_SECONDS=6
WEATHER_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------- 云拓（yuntuo-fpga 分支）
# 开机脚本跳过 C 板 / Nav2 / 旧相机；导航与运动控制在 FPGA 上，见 docs/YUNTUO.md
YUNTUO_MODE=true
# 覆盖上面的 Nav2 时代配置：
#   QHXD_BOOT_START_NAV_FRONTEND=false  QHXD_BOOT_NAV_MODE=none  QHXD_BOOT_START_NAV_WEB_BRIDGE=false
#   WAYPOINTS_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/yuntuo/waypoints.json
#   PATROL_ROUTES_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/yuntuo/patrol_routes.json
# FPGA 导航链路：uart:/dev/yuntuo-fpga（板载 USB 串口，方案 R0）或 udp:192.168.2.100（SFP，IP 生成后）
YUNTUO_FPGA_LINK=uart:/dev/yuntuo-fpga
YUNTUO_FPGA_IS_MOCK=false
# 底盘控制遥测（只读，不发速度）：serial:/dev/yuntuo-ctl@230400；没接就留空
YUNTUO_CONTROL_TELEMETRY=
# 先验地图包（tools/map_tool.py 生成的 .nvmp）；无图模式留空
YUNTUO_PRIOR_MAP=
YUNTUO_MAP_ID=yuntuo_field
YUNTUO_FIELD_BOUNDS=-1,-3,6,3
YUNTUO_ALLOW_MAPLESS_GOTO=true
YUNTUO_REQUIRE_LOCALIZATION=true
YUNTUO_BLOCKED_FAIL_SECONDS=25
YUNTUO_TARGET_RATE_HZ=12
YUNTUO_TARGET_MAX_LATENCY_MS=400
YUNTUO_PLATFORM_MAX_AGE_SECONDS=3
YUNTUO_REQUIRE_CONTROL_LINK=false
# 感知：Astra Pro Plus
YUNTUO_CAMERA_SOURCE=astra
YUNTUO_COLOR_DEVICE=/dev/yuntuo-astra-color
OPENNI2_REDIST=/opt/OpenNI2/Redist
YUNTUO_DETECTOR=rknn
# 相机在机身系的安装：x,y,z(m),pitch(向下为正),yaw,roll(度)，装好后实测
YUNTUO_CAMERA_MOUNT=0.20,0,0.30,10,0,0
YUNTUO_PERCEPTION_UDP=127.0.0.1:9102
# 离线大模型（RK3588 本机 OpenAI 兼容服务，例如 RKLLM / llama.cpp server）
#   LLM_BACKEND=local  LLM_ENABLE=true
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080
LLM_LOCAL_MODEL=qwen2.5-1.5b-instruct
LLM_LOCAL_TIMEOUT_SECONDS=20
LLM_LOCAL_JSON_MODE=true
# 离线 TTS：TTS_BACKEND=local，命令模板（不经 shell，{text} / {out} 会被替换）
#   TTS_LOCAL_CMD="sherpa-onnx-offline-tts --vits-model=/opt/tts/model.onnx --vits-tokens=/opt/tts/tokens.txt --vits-lexicon=/opt/tts/lexicon.txt --output-filename={out} {text}"
TTS_LOCAL_TIMEOUT=20
