# 云拓 RK3588 任务层配置模板：复制为 .env 后按实机修改。真实 .env 不入库（含密钥）。

# ---------------------------------------------------------------- FPGA 链路（fpga_bridge）
# 导航：uart:/dev/yuntuo-fpga（板载 USB 串口，方案 R0）或 udp:192.168.2.100（SFP，IP 生成后）
YUNTUO_FPGA_LINK=uart:/dev/yuntuo-fpga
YUNTUO_FPGA_IS_MOCK=false
# 底盘控制遥测（只读，不发速度）：serial:/dev/yuntuo-ctl@230400；没接就留空
YUNTUO_CONTROL_TELEMETRY=
# 先验地图包（导航仓库 tools/map_tool.py 生成的 .nvmp）；无图模式留空
YUNTUO_PRIOR_MAP=
YUNTUO_MAP_ID=yuntuo_field
YUNTUO_FIELD_BOUNDS=-1,-3,6,3
YUNTUO_ALLOW_MAPLESS_GOTO=true
YUNTUO_REQUIRE_LOCALIZATION=true
YUNTUO_BLOCKED_FAIL_SECONDS=25
YUNTUO_TARGET_RATE_HZ=12
YUNTUO_TARGET_MAX_LATENCY_MS=400
YUNTUO_PERCEPTION_UDP=127.0.0.1:9102
# FPGA 未烧录时用模拟器（scripts/install_yuntuo_services.sh --mock-fpga 装 yuntuo-mock-fpga）：
#   YUNTUO_FPGA_LINK=udp:127.0.0.1:9000  YUNTUO_FPGA_IS_MOCK=true  YUNTUO_CONTROL_TELEMETRY=udp:127.0.0.1:9104

# 后端 -> fpga_bridge 任务转发（仅本机）与预检
NAV_MISSION_EXECUTOR_BASE_URL=http://127.0.0.1:9101
NAV_MISSION_EXECUTOR_PATH=/api/internal/mission
NAV_MISSION_EXECUTOR_PORT=9101
NAV_MISSION_EXECUTOR_TIMEOUT_SECONDS=4
NAV_MISSION_MAX_NAV_AGE_SECONDS=3
NAV_MISSION_PREFLIGHT_ENABLED=true
YUNTUO_PLATFORM_MAX_AGE_SECONDS=3
YUNTUO_REQUIRE_CONTROL_LINK=false
WAYPOINTS_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/yuntuo/waypoints.json
PATROL_ROUTES_CONFIG_PATH=/home/robomaster/QHXD/backend/app/config/yuntuo/patrol_routes.json
MISSION_EVENT_TTS_ENABLED=true

# ---------------------------------------------------------------- 感知（Astra Pro Plus）
YUNTUO_CAMERA_SOURCE=astra
YUNTUO_COLOR_DEVICE=/dev/yuntuo-astra-color
OPENNI2_REDIST=/opt/OpenNI2/Redist
YUNTUO_DETECTOR=rknn
# INT8 模型（tools/convert_yolo26_int8.py 生成，不入库）：比 fp32 快约 2 倍、给板载大模型让出 NPU；去掉这两行用仓库里的 fp32
YUNTUO_RKNN_MODEL=/home/robomaster/models/yolo/yolo26n_int8.rknn
YUNTUO_DETECT_CONF=0.40
# 相机在机身系的安装：x,y,z(m),pitch(向下为正),yaw,roll(度)，装好后实测
YUNTUO_CAMERA_MOUNT=0.20,0,0.30,10,0,0

# 网页视觉窗口：最新帧刷新与 MJPEG
VITE_LATEST_FRAME_INTERVAL_MS=2000
VITE_USE_MJPEG_STREAM=true
PERCEPTION_MJPEG_INTERVAL_MS=200
VITE_DETECTION_EVENT_HOLD_MS=15000
VITE_DETECTION_EVENT_MAX_ITEMS=12

# 云端低延迟视频：感知节点把带检测框的画面经 RK MPP 硬件编码，RTMP 推到云端 MediaMTX，网页走 WebRTC（见 streaming/README.md）
QHXD_VIDEO_STREAM_ENABLED=false
YUNTUO_STREAM_FPS=15
YUNTUO_STREAM_SIZE=640x480
YUNTUO_STREAM_BITRATE=1000000
# 推流凭据只写在真实 .env 里
QHXD_VIDEO_STREAM_URL='rtmp://<cloud-host>:1935/robot/front?user=robot-publisher&pass=replace-me'

# ---------------------------------------------------------------- 语音识别（离线 SenseVoice）与录音
# sherpa：sherpa-onnx 版 SenseVoice int8（推荐，不依赖 torch）；funasr：FunASR + torch
ASR_BACKEND=sherpa
SHERPA_ASR_MODEL_DIR=/home/robomaster/models/asr/sherpa-onnx-sense-voice-zh-2024-07-17
SHERPA_ASR_THREADS=4
FUNASR_MODEL_PATH=/home/robomaster/.cache/modelscope/hub/models/iic/SenseVoiceSmall
FUNASR_VAD_MODEL_PATH=/home/robomaster/.cache/modelscope/hub/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_DEVICE=cpu
FUNASR_LANGUAGE=zh
FUNASR_USE_ITN=true
FUNASR_DISABLE_UPDATE=true
AUDIO_DEVICE=plughw:CARD=Device,DEV=0
AUDIO_RECORD_SECONDS=3
AUDIO_CHANNELS=1
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=S16_LE

# ---------------------------------------------------------------- 大模型意图解析
# 比赛现场推荐离线：LLM_BACKEND=local，RK3588 本机 yuntuo-llm（rknn-llm，NPU）的 OpenAI 兼容接口
LLM_BACKEND=local
LLM_ENABLE=true
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080
LLM_LOCAL_MODEL=qwen2.5-1.5b-instruct
LLM_LOCAL_TIMEOUT_SECONDS=20
LLM_LOCAL_JSON_MODE=true
# local 缺省用精简提示（板载模型上下文 1K）；full 为云端模型用的完整提示
LLM_PROMPT_STYLE=
# yuntuo-llm 服务（scripts/install_rkllm_runtime.sh 装运行库；模型不入库）
RKLLM_MODEL_PATH=/home/robomaster/models/llm/qwen2.5-1.5b-instruct-w8a8/Qwen2.5-1.5B-Instruct.rkllm
RKLLM_LIB_PATH=/opt/rkllm/1.3.1/librkllmrt.so
RKLLM_PORT=8080
RKLLM_MAX_CONTEXT=1024
RKLLM_MAX_NEW_TOKENS=256
# 在线备选：LLM_BACKEND=deepseek
DEEPSEEK_ENABLE=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DISPLAY_MODEL="DeepSeek V4 Flash"
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.1

# 安全校验（运动类命令必须确认）
LLM_CONFIDENCE_THRESHOLD=0.75
LLM_REQUIRE_CONFIRM_FOR_MOTION=true
LLM_FALLBACK_TO_RULE=true
LLM_DEBUG_RAW=false
VOICE_PENDING_TTL_SECONDS=30

# ---------------------------------------------------------------- 语音播报
# mock：只记录文本；local：离线（推荐）；online：MiMO TTS
TTS_BACKEND=local
# local 优先走常驻合成服务 yuntuo-tts（sherpa-onnx，模型常驻内存）；没配 URL 时才用 TTS_LOCAL_CMD 命令模板
TTS_LOCAL_URL=http://127.0.0.1:8081/tts
# TTS_LOCAL_CMD 不经 shell，{text} / {out} 会被替换，例如：
#   TTS_LOCAL_CMD="sherpa-onnx-offline-tts --vits-model=/opt/tts/model.onnx --vits-tokens=/opt/tts/tokens.txt --vits-lexicon=/opt/tts/lexicon.txt --output-filename={out} {text}"
TTS_LOCAL_TIMEOUT=20
# yuntuo-tts 服务：matcha-icefall-zh-en（中英混读）+ vocos-16khz-univ
TTS_MODEL_KIND=matcha
TTS_MODEL_DIR=/home/robomaster/models/tts/matcha-icefall-zh-en
TTS_VOCODER_PATH=/home/robomaster/models/tts/vocoders/vocos-16khz-univ.onnx
TTS_NUM_THREADS=4
TTS_CPUS=4-7
TTS_PORT=8081
TTS_SPEED=1.0
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
MIMO_TTS_FORMAT=wav
TTS_API_TIMEOUT=15
# TTS_AUDIO_DIR 缺省为 backend/data/tts/
TTS_MAX_AUDIO_FILES=20
# 板载喇叭播放
TTS_AUTO_PLAY_LOCAL=false
TTS_PLAYER_CMD="aplay -D plughw:2,0"

# ---------------------------------------------------------------- 天气（Open-Meteo，联网时可用）
WEATHER_LOCATION=海南海口
WEATHER_LATITUDE=20.0440
WEATHER_LONGITUDE=110.1999
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_TIMEOUT_SECONDS=6
WEATHER_CACHE_TTL_SECONDS=300
